{
  "name": "bangladesh-tax-calculator",
  "version": "1.1.0",
  "private": false,
  "engines": {
    "node": ">=16.0.0 <25.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "serve": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --fix src/",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "prepare": "husky",
    "security:scan": "trivy fs --scanners vuln,secret .",
    "security:scan-image": "trivy image --scanners vuln,secret",
    "security:config": "trivy config .",
    "mcp:start": "node packages/mcp/bin/tax-calculator-mcp.js",
    "mcp:test": "npm --prefix packages/mcp test",
    "v2:dev": "npm --prefix apps/web-v2 run dev",
    "v2:build": "npm --prefix apps/web-v2 run build",
    "v2:verify-bend": "node scripts/bend-verify.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "vue": "^3.4.0",
    "vue-router": "^5.0.4",
    "vuex": "^4.1.0",
    "vuex-persistedstate": "^4.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/eslint-parser": "^7.22.0",
    "@playwright/test": "^1.54.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.2",
    "vue-eslint-parser": "^10.4.0"
  },
  "resolutions": {
    "@vue/server-renderer": "3.5.42"
  },
  "keywords": [
    "vue",
    "vuejs",
    "tax-calculator",
    "bangladesh",
    "tax",
    "salaried",
    "income-tax",
    "calculator"
  ],
  "description": "Bangladesh Tax Calculator - A Vue.js application for calculating income tax for salaried people in Bangladesh with support for 2023-2024 tax years",
  "homepage": "http://tax.nadimtuhin.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadimtuhin/tax-calculator.git"
  },
  "bugs": {
    "url": "https://github.com/nadimtuhin/tax-calculator/issues"
  },
  "author": "Nadim Tuhin <nadimtuhin@gmail.com>",
  "license": "MIT",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
